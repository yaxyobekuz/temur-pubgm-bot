NODE_ENV=development

# Telegram
BOT_TOKEN=replace_me_telegram_bot_token

# Backend API (server)
API_BASE_URL=http://localhost:5000/api

# Must match server's BOT_SHARED_SECRET
BOT_SHARED_SECRET=replace_me_bot_secret

# Internal HTTP server used by the backend (send-message, check-membership).
# Bind to loopback only - never expose this port to the internet.
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=5300

# Ro'yxatdan o'tgach yuboriladigan qo'llanma videosining Telegram file_id'si.
# Bo'sh qoldirilsa - matnli qo'llanma yuboriladi.
GUIDE_VIDEO_FILE_ID=
